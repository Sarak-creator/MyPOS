// អាណាចក្រPOS (Anachak POS) Enterprise Database Schema
// Database Engine: PostgreSQL

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------
// 1. Multi-Tenancy, Branches & Warehouses
// ----------------------------------------------------

model Tenant {
  id             String    @id @default(uuid())
  name           String    // e.g. "Anachak Tech Group"
  storeAddress   String    @unique @default("anajak@anajak.com")
  legalName      String?
  vatNumber      String?
  phone          String?
  email          String?
  address        String?
  currency       String    @default("USD")
  exchangeRate   Int       @default(4100)
  defaultTaxRate Float     @default(0)
  logoUrl        String?
  plan           String    @default("ENTERPRISE")
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  branches    Branch[]
  users       User[]
  categories  Category[]
  products    Product[]
  customers   Customer[]
  suppliers   Supplier[]
  accounts    Account[]
}

model Branch {
  id          String    @id @default(uuid())
  tenantId    String
  code        String    // e.g. "BR-PP01"
  name        String    // e.g. "សាខា ភ្នំពេញ (Phnom Penh Main)"
  nameEn      String?
  phone       String?
  email       String?
  address     String?
  isHeadOffice Boolean  @default(false)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouses  Warehouse[]
  users       User[]
  orders      Order[]
  repairs     RepairTicket[]
  cashDrawers CashDrawerShift[]
  expenses    Expense[]
  transfersFrom StockTransfer[] @relation("TransferOrigin")
  transfersTo   StockTransfer[] @relation("TransferDestination")
  attendances Attendance[]
  stockItems  StockItem[]

  @@unique([tenantId, code])
}

model Warehouse {
  id          String    @id @default(uuid())
  branchId    String
  name        String    // e.g. "ឃ្លាំងកណ្តាល (Main Stockroom)"
  location    String?
  isDefault   Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  branch      Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  stockItems  StockItem[]
  adjustments StockAdjustment[]
}

// ----------------------------------------------------
// 2. Authentication, Users & RBAC Matrix
// ----------------------------------------------------

enum RoleType {
  SUPER_ADMIN
  ADMIN
  BRANCH_MANAGER
  CASHIER
  TECHNICIAN
  ACCOUNTANT
  INVENTORY_CLERK
}

model User {
  id            String    @id @default(uuid())
  tenantId      String
  branchId      String?
  username      String    @unique
  email         String?   @unique
  passwordHash  String
  fullName      String
  fullNameKh    String?
  phone         String?
  role          RoleType  @default(CASHIER)
  permissions   String[]  // Array of permission slugs e.g. ["pos:discount", "repairs:delete"]
  isActive      Boolean   @default(true)
  avatarUrl     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch        Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  orders        Order[]   @relation("CashierOrders")
  assignedRepairs RepairTicket[] @relation("TechnicianRepairs")
  auditLogs     AuditLog[]
  cashDrawers   CashDrawerShift[]
  employee      Employee?
}

model AuditLog {
  id          String    @id @default(uuid())
  userId      String
  action      String    // e.g. "PRICE_OVERRIDE", "DRAWER_OPEN", "REPAIR_UPDATE", "STOCK_ADJUST"
  entity      String    // e.g. "Order", "RepairTicket", "Product"
  entityId    String?
  details     Json?     // Old vs New values, metadata
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ----------------------------------------------------
// 3. Products, Catalog & Inventory / IMEI Management
// ----------------------------------------------------

model Category {
  id          String    @id @default(uuid())
  tenantId    String
  nameKh      String    // e.g. "ទូរស័ព្ទដៃ"
  nameEn      String    // e.g. "Smartphones"
  slug        String
  icon        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products    Product[]
}

model Brand {
  id          String    @id @default(uuid())
  name        String    // e.g. "Apple", "Samsung", "Xiaomi"
  logoUrl     String?
  products    Product[]
}

enum ProductType {
  STANDARD_ITEM
  SERIAL_IMEI_ITEM   // Phones, Laptops, Tablets
  VARIANT_ITEM       // Sizes, Colors
  SERVICE_LABOR      // Repair labor / Software flash
  SPARE_PART         // Screen, Battery, Charging IC
}

model Product {
  id            String       @id @default(uuid())
  tenantId      String
  categoryId    String?
  brandId       String?
  sku           String       @unique
  barcode       String?      @unique
  nameKh        String       // e.g. "iPhone 15 Pro Max 256GB"
  nameEn        String
  description   String?
  type          ProductType  @default(STANDARD_ITEM)
  costPriceUsd  Decimal      @db.Decimal(12, 2)
  salePriceUsd  Decimal      @db.Decimal(12, 2)
  salePriceKhr  Decimal      @db.Decimal(14, 2)
  wholesalePriceUsd Decimal? @db.Decimal(12, 2)
  minStockAlert Int          @default(5)
  unit          String       @default("Pcs") // Pcs, Box, Set, Pack
  imageUrl      String?
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category      Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brand         Brand?       @relation(fields: [brandId], references: [id], onDelete: SetNull)
  variants      ProductVariant[]
  stockItems    StockItem[]
  orderItems    OrderItem[]
  repairParts   RepairPartUsed[]
  purchaseOrderItems PurchaseOrderItem[]
}

model ProductVariant {
  id            String       @id @default(uuid())
  productId     String
  sku           String       @unique
  barcode       String?      @unique
  variantName   String       // e.g. "Natural Titanium / 256GB"
  costPriceUsd  Decimal      @db.Decimal(12, 2)
  salePriceUsd  Decimal      @db.Decimal(12, 2)
  salePriceKhr  Decimal      @db.Decimal(14, 2)
  stockQuantity Int          @default(0)

  product       Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
}

enum StockStatus {
  IN_STOCK
  RESERVED
  SOLD
  USED_IN_REPAIR
  DEFECTIVE
  TRANSFERRED
}

model StockItem {
  id            String       @id @default(uuid())
  productId     String
  warehouseId   String
  branchId      String
  serialOrImei  String?      @unique // Unique for Phone IMEI / Laptop Serial
  batchNumber   String?
  expirationDate DateTime?
  quantity      Int          @default(1)
  costPriceUsd  Decimal      @db.Decimal(12, 2)
  status        StockStatus  @default(IN_STOCK)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  product       Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse     Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  branch        Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  orderItem     OrderItem?   @relation(fields: [orderItemId], references: [id])
  orderItemId   String?      @unique
  repairPart    RepairPartUsed? @relation(fields: [repairPartId], references: [id])
  repairPartId  String?      @unique
}

enum TransferStatus {
  PENDING
  APPROVED
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

model StockTransfer {
  id              String         @id @default(uuid())
  transferNumber  String         @unique // e.g. "TR-202608-001"
  fromBranchId    String
  toBranchId      String
  status          TransferStatus @default(PENDING)
  notes           String?
  approvedBy      String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  fromBranch      Branch         @relation("TransferOrigin", fields: [fromBranchId], references: [id])
  toBranch        Branch         @relation("TransferDestination", fields: [toBranchId], references: [id])
  items           StockTransferItem[]
}

model StockTransferItem {
  id              String         @id @default(uuid())
  transferId      String
  productId       String
  quantity        Int
  serialOrImeis   String[]

  transfer        StockTransfer  @relation(fields: [transferId], references: [id], onDelete: Cascade)
}

enum AdjustmentReason {
  DAMAGE
  EXPIRED
  THEFT_LOSS
  COUNT_CORRECTION
  SCRAP
}

model StockAdjustment {
  id              String           @id @default(uuid())
  warehouseId     String
  reason          AdjustmentReason
  notes           String?
  adjustedBy      String
  createdAt       DateTime         @default(now())

  warehouse       Warehouse        @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  items           StockAdjustmentItem[]
}

model StockAdjustmentItem {
  id              String           @id @default(uuid())
  adjustmentId    String
  productId       String
  quantityDelta   Int              // Positive or Negative
  costImpactUsd   Decimal          @db.Decimal(12, 2)

  adjustment      StockAdjustment  @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
}

// ----------------------------------------------------
// 4. Point of Sale (POS), Orders, Invoices & KHQR
// ----------------------------------------------------

enum OrderStatus {
  COMPLETED
  HELD
  REFUNDED
  PARTIALLY_REFUNDED
  CANCELLED
}

enum PaymentMethod {
  CASH_USD
  CASH_KHR
  KHQR_ABA
  KHQR_BAKONG
  CREDIT_CARD
  CUSTOMER_CREDIT // On Account / Debt (បំណុល)
  SPLIT_PAYMENT
}

model Customer {
  id            String    @id @default(uuid())
  tenantId      String
  name          String    // e.g. "សុខ វិបុល (Sok Vibol)"
  phone         String    @unique
  email         String?
  address       String?
  tier          String    @default("RETAIL") // RETAIL, WHOLESALE, VIP
  loyaltyPoints Int       @default(0)
  creditLimitUsd Decimal  @default(0) @db.Decimal(12, 2)
  currentDebtUsd Decimal  @default(0) @db.Decimal(12, 2)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders        Order[]
  repairs       RepairTicket[]
  debts         DebtPaymentSchedule[]
}

model Order {
  id              String        @id @default(uuid())
  invoiceNumber   String        @unique // e.g. "INV-202608-0001"
  branchId        String
  customerId      String?
  cashierId       String
  cashDrawerId    String?
  status          OrderStatus   @default(COMPLETED)
  subtotalUsd     Decimal       @db.Decimal(12, 2)
  discountType    String?       // "PERCENT" or "FIXED"
  discountAmount  Decimal       @default(0) @db.Decimal(12, 2)
  taxRatePercent  Decimal       @default(0) @db.Decimal(5, 2)
  taxAmountUsd    Decimal       @default(0) @db.Decimal(12, 2)
  totalUsd        Decimal       @db.Decimal(12, 2)
  totalKhr        Decimal       @db.Decimal(14, 2)
  exchangeRateKhr Decimal       @default(4100) @db.Decimal(10, 2)
  notes           String?
  khqrQrString    String?       // Raw EMVCo payload for verification
  khqrMd5         String?       // Transaction identifier for webhook match
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  branch          Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  customer        Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  cashier         User          @relation("CashierOrders", fields: [cashierId], references: [id])
  cashDrawer      CashDrawerShift? @relation(fields: [cashDrawerId], references: [id], onDelete: SetNull)
  items           OrderItem[]
  payments        Payment[]
}

model OrderItem {
  id              String        @id @default(uuid())
  orderId         String
  productId       String
  unitCostUsd     Decimal       @db.Decimal(12, 2)
  unitPriceUsd    Decimal       @db.Decimal(12, 2)
  unitPriceKhr    Decimal       @db.Decimal(14, 2)
  quantity        Int
  discountAmount  Decimal       @default(0) @db.Decimal(12, 2)
  totalPriceUsd   Decimal       @db.Decimal(12, 2)

  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product       @relation(fields: [productId], references: [id])
  stockItem       StockItem?
}

model Payment {
  id              String        @id @default(uuid())
  orderId         String
  method          PaymentMethod
  amountUsd       Decimal       @db.Decimal(12, 2)
  amountKhr       Decimal       @default(0) @db.Decimal(14, 2)
  exchangeRate    Decimal       @default(4100) @db.Decimal(10, 2)
  tenderedUsd     Decimal?      @db.Decimal(12, 2)
  changeUsd       Decimal?      @db.Decimal(12, 2)
  referenceNumber String?       // e.g. ABA Bank Ref / Card Auth Code
  createdAt       DateTime      @default(now())

  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model CashDrawerShift {
  id              String        @id @default(uuid())
  branchId        String
  userId          String
  openingTime     DateTime      @default(now())
  closingTime     DateTime?
  startingCashUsd Decimal       @db.Decimal(12, 2)
  startingCashKhr Decimal       @db.Decimal(14, 2)
  actualCashUsd   Decimal?      @db.Decimal(12, 2)
  actualCashKhr   Decimal?      @db.Decimal(14, 2)
  differenceUsd   Decimal?      @db.Decimal(12, 2)
  notes           String?
  status          String        @default("OPEN") // OPEN, CLOSED

  branch          Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id])
  orders          Order[]
}

// ----------------------------------------------------
// 5. Repairing & Service Management Module
// ----------------------------------------------------

enum RepairStatus {
  RECEIVED
  DIAGNOSING
  QUOTED
  APPROVED_BY_CUSTOMER
  IN_PROGRESS
  WAITING_FOR_PARTS
  READY_FOR_PICKUP
  DELIVERED
  CANCELLED
  UNDER_WARRANTY
}

model RepairTicket {
  id              String        @id @default(uuid())
  ticketNumber    String        @unique // e.g. "REP-202608-0100"
  branchId        String
  customerId      String
  technicianId    String?
  deviceType      String        // e.g. "Smartphone", "Laptop", "iPad", "Smartwatch"
  deviceBrand     String        // e.g. "Apple", "Samsung", "Asus"
  deviceModel     String        // e.g. "iPhone 14 Pro"
  imeiOrSerial    String?       // Device Serial / IMEI
  passcode        String?       // Passcode if provided
  patternLock     String?       // Pattern coordinates e.g. "1-4-7-8-9"
  cosmeticCondition String?     // e.g. "Scratched back, cracked front glass"
  customerProblem String        // e.g. "Battery drains fast and no sound on speaker"
  diagnosticNotes String?
  estimatedCostUsd Decimal?     @db.Decimal(12, 2)
  finalCostUsd    Decimal?      @db.Decimal(12, 2)
  depositPaidUsd  Decimal       @default(0) @db.Decimal(12, 2)
  status          RepairStatus  @default(RECEIVED)
  warrantyDays    Int           @default(30)
  completedAt     DateTime?
  deliveredAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  branch          Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  customer        Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  technician      User?         @relation("TechnicianRepairs", fields: [technicianId], references: [id])
  statusLogs      RepairStatusLog[]
  partsUsed       RepairPartUsed[]
  commissions     TechnicianCommission[]
}

model RepairStatusLog {
  id              String        @id @default(uuid())
  repairTicketId  String
  fromStatus      RepairStatus
  toStatus        RepairStatus
  changedBy       String        // User Full Name / ID
  notes           String?
  notifiedCustomer Boolean      @default(false)
  createdAt       DateTime      @default(now())

  repairTicket    RepairTicket  @relation(fields: [repairTicketId], references: [id], onDelete: Cascade)
}

model RepairPartUsed {
  id              String        @id @default(uuid())
  repairTicketId  String
  productId       String        // Spare part product ID
  quantity        Int           @default(1)
  costPriceUsd    Decimal       @db.Decimal(12, 2)
  salePriceUsd    Decimal       @db.Decimal(12, 2)
  createdAt       DateTime      @default(now())

  repairTicket    RepairTicket  @relation(fields: [repairTicketId], references: [id], onDelete: Cascade)
  product         Product       @relation(fields: [productId], references: [id])
  stockItem       StockItem?
}

model TechnicianCommission {
  id              String        @id @default(uuid())
  repairTicketId  String
  technicianId    String
  commissionUsd   Decimal       @db.Decimal(12, 2)
  isPaid          Boolean       @default(false)
  createdAt       DateTime      @default(now())

  repairTicket    RepairTicket  @relation(fields: [repairTicketId], references: [id], onDelete: Cascade)
}

// ----------------------------------------------------
// 6. Accounting, Chart of Accounts & General Ledger
// ----------------------------------------------------

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

model Account {
  id              String        @id @default(uuid())
  tenantId        String
  code            String        // e.g. "1010 Cash on Hand", "4010 POS Sales"
  nameKh          String
  nameEn          String
  type            AccountType
  balanceUsd      Decimal       @default(0) @db.Decimal(14, 2)
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lineItems       JournalLineItem[]
  expenses        Expense[]

  @@unique([tenantId, code])
}

model JournalEntry {
  id              String        @id @default(uuid())
  entryNumber     String        @unique // e.g. "JE-202608-0001"
  date            DateTime      @default(now())
  reference       String?       // Invoice / PO number
  description     String
  isPosted        Boolean       @default(true)
  createdAt       DateTime      @default(now())

  lineItems       JournalLineItem[]
}

model JournalLineItem {
  id              String        @id @default(uuid())
  journalEntryId  String
  accountId       String
  debitUsd        Decimal       @default(0) @db.Decimal(14, 2)
  creditUsd       Decimal       @default(0) @db.Decimal(14, 2)
  memo            String?

  journalEntry    JournalEntry  @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account         Account       @relation(fields: [accountId], references: [id])
}

model Expense {
  id              String        @id @default(uuid())
  branchId        String
  accountId       String
  category        String        // e.g. "Rent", "Electricity", "Internet", "Water"
  amountUsd       Decimal       @db.Decimal(12, 2)
  amountKhr       Decimal       @default(0) @db.Decimal(14, 2)
  receiptUrl      String?
  paidTo          String?
  notes           String?
  date            DateTime      @default(now())
  createdAt       DateTime      @default(now())

  branch          Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  account         Account       @relation(fields: [accountId], references: [id])
}

// ----------------------------------------------------
// 7. Suppliers & Purchase Orders
// ----------------------------------------------------

model Supplier {
  id              String        @id @default(uuid())
  tenantId        String
  companyName     String
  contactPerson   String?
  phone           String
  email           String?
  address         String?
  currentBalanceUsd Decimal     @default(0) @db.Decimal(12, 2)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrders  PurchaseOrder[]
}

enum POStatus {
  DRAFT
  ORDERED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id              String        @id @default(uuid())
  poNumber        String        @unique // e.g. "PO-202608-001"
  supplierId      String
  status          POStatus      @default(DRAFT)
  totalCostUsd    Decimal       @db.Decimal(12, 2)
  notes           String?
  orderedAt       DateTime      @default(now())
  receivedAt      DateTime?

  supplier        Supplier      @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  items           PurchaseOrderItem[]
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  productId       String
  quantity        Int
  unitCostUsd     Decimal       @db.Decimal(12, 2)
  totalCostUsd    Decimal       @db.Decimal(12, 2)

  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product         Product       @relation(fields: [productId], references: [id])
}

// ----------------------------------------------------
// 8. HRM & Payroll Module
// ----------------------------------------------------

model Employee {
  id              String        @id @default(uuid())
  userId          String?       @unique
  employeeCode    String        @unique // e.g. "EMP-001"
  fullNameKh      String
  fullNameEn      String
  position        String        // Cashier, Senior Technician, Manager
  baseSalaryUsd   Decimal       @db.Decimal(10, 2)
  hireDate        DateTime
  bankAccount     String?
  phone           String
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())

  user            User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  attendances     Attendance[]
  payrolls        PayrollRecord[]
}

model Attendance {
  id              String        @id @default(uuid())
  employeeId      String
  branchId        String
  date            DateTime      @db.Date
  checkIn         DateTime
  checkOut        DateTime?
  status          String        @default("PRESENT") // PRESENT, LATE, ABSENT, LEAVE
  notes           String?

  employee        Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  branch          Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
}

model PayrollRecord {
  id              String        @id @default(uuid())
  employeeId      String
  monthYear       String        // e.g. "2026-08"
  baseSalaryUsd   Decimal       @db.Decimal(10, 2)
  overtimePayUsd  Decimal       @default(0) @db.Decimal(10, 2)
  commissionUsd   Decimal       @default(0) @db.Decimal(10, 2)
  bonusUsd        Decimal       @default(0) @db.Decimal(10, 2)
  deductionUsd    Decimal       @default(0) @db.Decimal(10, 2)
  netSalaryUsd    Decimal       @db.Decimal(10, 2)
  isDisbursed     Boolean       @default(false)
  disbursedAt     DateTime?
  createdAt       DateTime      @default(now())

  employee        Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

// ----------------------------------------------------
// 9. Debt Management (បំណុល) & Customer Credit
// ----------------------------------------------------

enum DebtStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
}

model DebtPaymentSchedule {
  id              String        @id @default(uuid())
  customerId      String
  orderId         String?
  totalDebtUsd    Decimal       @db.Decimal(12, 2)
  paidAmountUsd   Decimal       @default(0) @db.Decimal(12, 2)
  remainingUsd    Decimal       @db.Decimal(12, 2)
  dueDate         DateTime
  status          DebtStatus    @default(PENDING)
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  customer        Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  payments        DebtPaymentLog[]
}

model DebtPaymentLog {
  id              String        @id @default(uuid())
  debtScheduleId  String
  amountPaidUsd   Decimal       @db.Decimal(12, 2)
  paymentMethod   PaymentMethod
  paidAt          DateTime      @default(now())
  receivedBy      String        // User name
  notes           String?

  debtSchedule    DebtPaymentSchedule @relation(fields: [debtScheduleId], references: [id], onDelete: Cascade)
}
