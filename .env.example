# ==============================================================================
# Vercel Environment Variables Configuration for Anachak POS
# Copy and paste your actual values into Vercel Project Settings > Environment Variables
# ==============================================================================

NODE_ENV=production

# Database (PostgreSQL - Supabase Session/Pooler Port 5432 or 6543)
DATABASE_URL="postgresql://postgres.your-project-id:your-db-password@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres?connection_limit=10&pool_timeout=20"
DIRECT_URL="postgresql://postgres.your-project-id:your-db-password@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres"

# Supabase API & Realtime Credentials
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# JWT Secret for Session & Auth
JWT_SECRET="your-jwt-secret-key"
JWT_EXPIRES_IN="7d"

# Bakong / ACLEDA / ABA KHQR Merchant Details
NEXT_PUBLIC_KHQR_MERCHANT_NAME="YOUR MERCHANT NAME"
NEXT_PUBLIC_KHQR_MERCHANT_CITY="Phnom Penh"
NEXT_PUBLIC_KHQR_MERCHANT_ID="85514965629"
NEXT_PUBLIC_BAKONG_ACCOUNT="khqr@aclb"
NEXT_PUBLIC_ACQUIRING_BANK="ACLEDA"
NEXT_PUBLIC_MERCHANT_MOBILE="0963760229"
NEXT_PUBLIC_RAW_KHQR=""
NEXT_PUBLIC_DEFAULT_CURRENCY="USD"
NEXT_PUBLIC_EXCHANGE_RATE_KHR="4100"
NEXT_PUBLIC_EXCHANGE_RATE_THB="36"

# Telegram Bot Notifications
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
TELEGRAM_CHAT_ID="your-telegram-chat-id"

# System Defaults
NEXT_PUBLIC_APP_NAME="អាណាចក្រPOS"
NEXT_PUBLIC_APP_SLOGAN="ប្រព័ន្ធគ្រប់គ្រងការលក់ និងសេវាកម្មជួសជុលកម្រិតសហគ្រាស"

